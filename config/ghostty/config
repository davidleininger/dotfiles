theme = cobalt-next
font-size = 16
font-feature = "-calt"
font-feature = "-liga"
font-feature = "-dlig"
window-padding-x = 12
mouse-hide-while-typing = true
shell-integration-features = path,ssh-env,ssh-terminfo,sudo,title
cursor-style = block
cursor-style-blink = false
clipboard-read = "allow"
macos-titlebar-style = "tabs"
window-inherit-working-directory = false
font-family = OperatorMono Nerd Font Mono
