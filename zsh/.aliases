# ── Navigation
alias k="clear"
alias jk="clear"
alias x="exit"
alias q="exit"
alias :q="exit"
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ......="cd ../../../../.."

# ── Shell
alias resource="source ~/.zshrc"
alias reload="source ~/.zshrc"
alias aa="cat ~/.aliases"
alias please=sudo
alias ltr="ls -ltr"
alias cat=bat

# ── macOS
alias afk="open -a /System/Library/Frameworks/ScreenSaver.framework/Versions/A/Resources/ScreenSaverEngine.app"
alias rm=trash
alias empty-trash='/bin/rm -rf ~/.Trash/* && echo "Trash emptied."'
alias getip='ip=$(ipconfig getifaddr utun0 2>/dev/null || ipconfig getifaddr en0) && echo $ip | pbcopy && echo "\n  $ip\n  (copied to clipboard)\n"'

# ── Homebrew
alias bbd="brew bundle dump --force --file=$HOME/dev/dotfiles/Brewfile"

# ── Git
alias g="git"
alias ga="git add"
alias gcam="git commit -am"
alias gcmsg="git commit --message"
alias gco="git checkout"
alias gbc="git checkout -b"
alias gcm="git_checkout_default_branch"
alias gd="git diff"
alias gf="git fetch --all --prune"
alias gl="git pull"
alias glg="git log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all"
alias glm="git_checkout_default_branch_and_pull"
alias glmm="pull_and_merge_default"
alias gmm="merge_default"
alias gopen="git open"
alias gp="git push"
alias gpo="git push origin"
alias gpm="git_pull_origin_default_branch"
alias gpub="publish_current_branch"
alias gpull="pull_origin_current_branch"
alias gs="git status"
alias gba="git branch --all"
alias gbam="delete_local_merged_branches"
alias gbamr="delete_remote_merged_branches"
alias gbx="git branch -D"
alias gclean="delete_local_merged_branches && delete_remote_merged_branches"
alias gconflicts="git diff --name-only --diff-filter=U"

# ── Node / npm
alias r="npm run"
alias use_npm="npm set registry https://registry.npmjs.org/ && npm get registry"

# ── VS Code
alias co="code ."
alias cor="code . -r"

# ── Netlify
alias net="netlify"
alias nd="netlify dev"

# ── Tools
alias yt4="yt-dlp -f mp4"
alias kp="kill_port"
alias kill_port="kill_port"
