# Git stuff
function git_current_branch() {
  if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    print "$0: not a repository: $PWD" >&2
    return 1
  fi

  local ref="$(git symbolic-ref HEAD 2> /dev/null)"

  if [[ -n "$ref" ]]; then
    print "${ref#refs/heads/}"
    return 0
  else
    return 1
  fi
}

function git_default_branch() {
  git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'
}

function git_checkout_default_branch() {
  local default_branch="$(git_default_branch)"
  git checkout $default_branch
}

function git_pull_origin_default_branch() {
  local default_branch="$(git_default_branch)"
  git pull origin $default_branch
}

function git_checkout_default_branch_and_pull() {
  local default_branch="$(git_default_branch)"
  git checkout $default_branch && git pull
}

function pull_and_merge_default() {
  local default_branch="$(git_default_branch)"
  local current_branch="$(git_current_branch)"
  git checkout $default_branch
  git pull
  git checkout $current_branch
  git merge $default_branch
}

function merge_default() {
  local default_branch="$(git_default_branch)"
  git merge $default_branch
}

function publish_current_branch() {
  local current_branch="$(git_current_branch)"
  git push --set-upstream origin $current_branch:$current_branch
}

function pull_origin_current_branch() {
  local current_branch="$(git_current_branch)"
  git pull origin $current_branch
}

function delete_local_merged_branches() {
  local default_branch="$(git_default_branch)"
  git branch --merged | egrep -v "(^\*|$default_branch)" | xargs git branch -d
}

function delete_remote_merged_branches() {
  local default_branch="$(git_default_branch)"
  git fetch origin
  git remote prune origin
  git branch -r --merged origin/$default_branch \
    | awk -v db="$default_branch" -F'/' '/^ *origin/{if(!match($0, /(>)/) && !match($0, db)){print $2}}' \
    | xargs git push origin --delete
}

# Mac stuff
function kill_port() {
  lsof -nti:"$1" | xargs kill -9
  echo "$1 killed"
}

# I hate remembering syntax for copying to clipboard
function copy() {
  if [[ ! -f "$1" ]]; then
    echo "$(tput setaf 1)Error: file '${1}' not found."
    return 1
  fi
  pbcopy < $1
  echo "$(tput setaf 2)Contents of $(tput setaf 5)${1} $(tput setaf 2)copied to clipboard!"
}

# Voice Over Screenshot (voss) - default delay 10 seconds
# command: voss
# argument 1: delay in seconds (default 10)
# argument 2: filename (default VOscreenshot)
# argument 3: flags (e.g., -c to copy to clipboard instead of saving, -t to have the countdown read out loud)
# e.g., voss | 10 seconds, filename = VOscreenshot, no flags
# e.g., voss 5 headings -c | delay = 5 seconds, filename is headings, -c sends the file to the clipboard
function voss() {
  setopt LOCAL_OPTIONS NO_NOTIFY NO_MONITOR
  local delay="${1:-10}"
  local filename="VOscreenshot"
  local flags=""

  shift
  for arg in "$@"; do
    if [[ $arg == -* ]]; then
      flags+="${arg#-}"
    else
      filename="$arg"
    fi
  done

  local sc_flags=""
  [[ $flags == *c* ]] && sc_flags="-c"

  # Use -T1 (minimum) when we're handling the countdown ourselves
  local sc_delay="$delay"
  [[ $flags == *t* ]] && sc_delay=1

  echo "get your screen ready..."

  if [[ $flags == *t* ]]; then
    for i in $(seq "$delay" -1 1); do
      say "$i" &
      sleep 1
      wait
    done
  fi

  screencapture -T"$sc_delay" $sc_flags ~/Desktop/"$filename".jpg

  afplay /System/Library/Sounds/Ping.aiff

  if [[ $flags == *c* ]]; then
    echo "$filename was copied to your clipboard"
  else
    echo "$filename.jpg saved to desktop"
  fi
}
